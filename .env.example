# ---------------------------------------------------------------
# M365 License Optimizer - environment configuration
# Copy to .env.local for local dev. In Azure App Service, set these
# under Settings > Environment variables (App settings), and put
# CLIENT_SECRET in Key Vault via a Key Vault reference.
# ---------------------------------------------------------------

# mock = demo data, no Graph calls. live = call Microsoft Graph.
DATA_MODE=mock

# --- Single-tenant shortcut (used when TENANTS is not set) ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=
TENANT_DISPLAY_NAME=Contoso Ltd

# --- Multi-tenant (optional). JSON array; overrides the 3 vars above.
# clientId/clientSecret per tenant are optional; when omitted, the
# global CLIENT_ID/CLIENT_SECRET are used (multi-tenant app registration
# admin-consented in each customer tenant).
# TENANTS=[{"id":"contoso","name":"Contoso","tenantId":"<guid>"},{"id":"subsidiary","name":"Subsidiary","tenantId":"<guid>","clientId":"<guid>","clientSecret":"<secret>"}]

# --- Cost model ---
CURRENCY=USD
# Days without Exchange/OneDrive/SharePoint/Teams activity before a user is "inactive"
INACTIVITY_DAYS=90
# Optional JSON overrides for the price book, keyed by skuPartNumber (monthly unit price)
# PRICE_OVERRIDES={"SPE_E3":39,"SPE_E5":60}

# --- Reminders and v2 features (live mode on Azure; see README) ---
# IANA time zone for the daily reminder run hour (default UTC)
# REMINDER_TIMEZONE=America/New_York
# STORAGE_ACCOUNT_NAME=
# ENABLE_SCHEDULER=true
# REMINDER_SENDER=license-reminders@contoso.com
# APP_BASE_URL=https://<your-app>.azurewebsites.net
# EASY_AUTH_ENABLED=true   # only when App Service Authentication is ON
# BILLING_ACCOUNT_NAME=    # optional: pin one MCA billing account
# DEV_ROLE=admin           # local development only: simulate the admin role
